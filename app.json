{
  "expo": {
    "name": "KEA Verify",
    "slug": "kea-verify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "keaverify",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.kea.verify"
    },
    "android": {
      "package": "com.kea.verify",
      "adaptiveIcon": {
        "backgroundColor": "#f9f9ff",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "KEA Verify uses the camera to scan hall-ticket QR codes and verify candidates."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KEA Verify uses your location only to confirm you are physically at your assigned exam centre before scanning.",
          "isAndroidForegroundService": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f9f9ff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.YOUR-CLIENT-ID"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
