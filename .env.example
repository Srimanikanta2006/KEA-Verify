# Copy this file to .env and fill in values from the Firebase console
# (Project settings → General → Your apps → SDK setup and configuration).
# These values are PUBLIC by design — Firestore Rules enforce security.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Cloud console → APIs & Services → Credentials → "Web client
# (Auto-created for Google Sign-In)" → Client ID. Required for native
# Google Sign-In → Firebase credential exchange.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Seed script only (scripts/seed-firebase.mjs). Create this in Firebase
# console → Project settings → Service accounts, paste the JSON one-liner.
FIREBASE_SERVICE_ACCOUNT=
